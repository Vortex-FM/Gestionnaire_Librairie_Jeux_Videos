<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Gestionnaire_de_librairie_Jeux_Videos.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <!-- Palette personnalisée aux couleurs de Steam -->
                <ColorPaletteResources x:Key="Dark"
                                       Accent="#1A9FFF"
                                       RegionColor="#171A21"
                                       BaseLow="#2A475E"
                                       BaseMediumLow="#3D6C8E"
                                       BaseMedium="#67C1F5"
                                       BaseHigh="#C7D5E0"
                                       AltHigh="#1B2838"
                                       AltMedium="#171A21"
                                       AltLow="#101822"
                                       ChromeLow="#171A21"
                                       ChromeMediumLow="#1B2838"
                                       ChromeMedium="#2A475E"
                                       ChromeHigh="#3D6C8E" />
            </FluentTheme.Palettes>
        </FluentTheme>
    </Application.Styles>

</Application>