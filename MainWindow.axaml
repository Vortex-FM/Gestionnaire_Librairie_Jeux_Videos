<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Gestionnaire_de_librairie_Jeux_Videos"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Gestionnaire_de_librairie_Jeux_Videos.MainWindow"
        x:DataType="local:MainWindow"
        Title="Gestionnaire_de_librairie_Jeux_Videos">

    <ScrollViewer>
        <StackPanel Orientation="Horizontal">

            <ListBox x:Name="GameList"
                     ItemsSource="{Binding Games}"
                     Width="400"
                     MinHeight="300"
                     Background="#00000000"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:Game">
                        <Grid ColumnDefinitions="Auto, *, 30,Auto">
                            <Button Grid.Column="0"
                                    Content="{Binding Name}"
                                    Click="AfficherInfo" />
                            <TextBlock Grid.Column="1"
                                       Text = " Disponible :"
                                       VerticalAlignment="Center" />
                            <CheckBox Grid.Column="2"
                                      IsChecked="{Binding Disponible, Mode=TwoWay}"/>
                            <Button Grid.Column="3"
                                    Content="supprimer"
                                    Click="Supprimer" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel>
                <Image x:Name="GameImage" Width="128"/>
                <ListBox x:Name="GameInfo"
                         ItemsSource="{Binding GameInfos}"
                         MinHeight="300"
                         MinWidth="300"
                         Background="#511991"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="280"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Content="Modifier"
                        Click="ModiferAfficher" />
            </StackPanel>
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Top">
                    <TextBox x:Name="SearchBox"
                             Width="200"
                             PlaceholderText="Rechercher un jeu..." />
                    <Button x:Name="BouttonRechercher"
                            Content="Rechercher"
                            Click="Rechercher" />
                </StackPanel>
                <Popup x:Name="PopUpResultats"
                       PlacementTarget="{Binding #BouttonRechercher}"
                       Placement="Bottom" IsLightDismissEnabled="True">
                    <Border Background="Gray" BorderBrush="Red" BorderThickness="2">
                        <StackPanel>
                            <TextBlock x:Name="AucunResultat" Text="Aucun Résultat" IsVisible="False"/>
                            <ListBox ItemsSource="{Binding SearchResults}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:Game">
                                        <Button Content="{Binding Name}"
                                                Click="ChoisirResultat"
                                                HorizontalAlignment="Stretch"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </Popup>
                <StackPanel x:Name="Ajouterinfos" Spacing="5" VerticalAlignment="Top" IsVisible="True" MaxWidth="250">
                    <TextBox x:Name="NomJeu" PlaceholderText="Name?" TextWrapping="Wrap"/>
                    <TextBox x:Name="DateJeu" PlaceholderText="Date de sortie?" TextWrapping="Wrap"/>
                    <TextBox x:Name="GenreJeu" PlaceholderText="Genre?" TextWrapping="Wrap"/>
                    <TextBox x:Name="SynopsisJeu" PlaceholderText="Synopsis?" TextWrapping="Wrap"/>
                    <TextBox x:Name="JeuScore" PlaceholderText="Rating?" TextWrapping="Wrap"/>
                    <TextBox x:Name="UrlJeu" PlaceholderText="Url Image?" TextWrapping="Wrap"/>
                    <Button Content="ajouter"
                            Click="Ajouter" />
                </StackPanel>

                <StackPanel x:Name="ModifierInfos" Spacing="5" VerticalAlignment="Top" IsVisible="False" MaxWidth="250">
                    <TextBox x:Name="GameName" PlaceholderText="Name?" TextWrapping="Wrap" />
                    <TextBox x:Name="GameDate" PlaceholderText="Date de sortie?" TextWrapping="Wrap"/>
                    <TextBox x:Name="GameGenre" PlaceholderText="Genre?" TextWrapping="Wrap"/>
                    <TextBox x:Name="GameSynopsis" PlaceholderText="Synopsis?" TextWrapping="Wrap"/>
                    <TextBox x:Name="GameRating" PlaceholderText="Rating?" TextWrapping="Wrap"/>
                    <TextBox x:Name="GameUrl" PlaceholderText="Url Image?" TextWrapping="Wrap"/>
                    <Button Content="Modifier"
                            Click="Modifier" />
                </StackPanel>
            </StackPanel>


        </StackPanel>
    </ScrollViewer>
</Window>

