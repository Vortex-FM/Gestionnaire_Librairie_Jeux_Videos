<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Gestionnaire_de_librairie_Jeux_Videos"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Gestionnaire_de_librairie_Jeux_Videos.MainWindow"
        x:DataType="local:MainWindow"
        Title="Gestionnaire_de_librairie_Jeux_Videos">

    <ScrollViewer>
        <StackPanel Orientation="Horizontal">

            <ListBox x:Name="GameList"
                     ItemsSource="{Binding Games}"
                     Width="400"
                     MinHeight="300"
                     Background="#00000000"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:Game">
                        <Grid ColumnDefinitions="Auto, *, 30,Auto">
                            <Button Grid.Column="0"
                                    Content="{Binding Name}"
                                    Click="AfficherInfo" />
                            <TextBlock Grid.Column="1"
                                       Text = " Disponible :"
                                       VerticalAlignment="Center" />
                            <CheckBox Grid.Column="2"
                                      IsChecked="{Binding Disponible, Mode=TwoWay}"/>
                            <Button Grid.Column="3"
                                    Content="supprimer"
                                    Click="Supprimer" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>



            <ListBox x:Name="GameInfo"
                     ItemsSource="{Binding GameInfos}"
                     Width="300"
                     MinHeight="300"
                     Background="#E014E0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:Game">
                        <Grid RowDefinitions="Auto, *, Auto">
                            <TextBlock Grid.Row="0"
                                       Text="{Binding Name}"/>
                            <TextBlock Grid.Row="1"
                                       Text = "{Binding Date}"/>
                            <TextBox Grid.Row="2"
                                     Text="{Binding Genre}"/>
                            <TextBox Grid.Row="3"
                                     Text="{Binding Synopsis}" TextWrapping="Wrap"/>
                            <TextBox Grid.Row="4"
                                     Text="{Binding Rating}"/>
                            <TextBox Grid.Row="5"
                                     Text="{Binding Disponible}"/>
                            <Image Source ="{Binding Url}" RenderOptions.BitmapInterpolationMode="None" Width="128" Grid.Row="6" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Top">
                    <TextBox x:Name="SearchBox"
                             Width="200"
                             PlaceholderText="Rechercher un jeu..." />

                    <Button Content="Rechercher"
                            Click="Rechercher" />

                </StackPanel>
                <StackPanel x:Name="ModifierInfos" Spacing="5" VerticalAlignment="Top" IsVisible="False">
                    <TextBox x:Name="GameName" PlaceholderText="Name?" />
                    <TextBox x:Name="GameDate" PlaceholderText="Date de sortie?" />
                    <TextBox x:Name="GameGenre" PlaceholderText="Genre?" />
                    <TextBox x:Name="GameSynopsis" PlaceholderText="Synopsis?" />
                    <TextBox x:Name="GameRating" PlaceholderText="Rating?" />
                    <TextBox x:Name="GameUrl" PlaceholderText="Url Image?" />

                    <Button Content="Modifier"
                            Click="Modifier" />
                </StackPanel>
                <StackPanel x:Name="Ajouterinfos" Spacing="5" VerticalAlignment="Top" IsVisible="True">
                    <TextBox x:Name="NomJeu" PlaceholderText="Name?" />
                    <TextBox x:Name="DateJeu" PlaceholderText="Date de sortie?" />
                    <TextBox x:Name="GenreJeu" PlaceholderText="Genre?" />
                    <TextBox x:Name="SynopsisJeu" PlaceholderText="Synopsis?" />
                    <TextBox x:Name="JeuScore" PlaceholderText="Rating?" />
                    <TextBox x:Name="UrlJeu" PlaceholderText="Url Image?" />
                    <Button Content="ajouter"
                            Click="Ajouter" />
                </StackPanel>
            </StackPanel>


        </StackPanel>
    </ScrollViewer>
</Window>

