<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Gestionnaire_de_librairie_Jeux_Videos"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="Gestionnaire_de_librairie_Jeux_Videos.MainWindow"
        x:DataType="local:MainWindow"
        RequestedThemeVariant="Dark"
        Background="#141414"
        Title="Gestionnaire_de_librairie_Jeux_Videos">

        <ScrollViewer>
                <StackPanel Margin="24" Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBox x:Name="SearchBox" Width="300" PlaceholderText="Rechercher un jeu..."/>
                                <Button x:Name="BouttonRechercher" Content="Rechercher" Click="Rechercher"/>
                                <Popup x:Name="PopUpResultats"
                                       PlacementTarget="{Binding #BouttonRechercher}"
                                       Placement="Bottom" IsLightDismissEnabled="True">
                                        <Border Background="#2B2B2B" BorderBrush="Gray" BorderThickness="1"
                                                Padding="4" MinWidth="220" MaxHeight="250">
                                                <StackPanel>
                                                        <TextBlock x:Name="AucunResultat" Text="Aucun résultat" IsVisible="False"/>
                                                        <ListBox ItemsSource="{Binding SearchResults}">
                                                                <ListBox.ItemTemplate>
                                                                        <DataTemplate x:DataType="local:Game">
                                                                                <Button Content="{Binding Name}" Click="ChoisirResultat"
                                                                                        HorizontalAlignment="Stretch"/>
                                                                        </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                        </ListBox>
                                                </StackPanel>
                                        </Border>
                                </Popup>
                        </StackPanel>
                        <Grid ColumnDefinitions="600,*" ColumnSpacing="24">
                                <ItemsControl Grid.Column="0" ItemsSource="{Binding Games}">
                                        <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:Game">
                                                        <Button Click="AfficherInfo" Padding="0" Margin="0,0,14,14"
                                                                Background="#DC9532B9" BorderThickness="0">
                                                                <Border Width="170" Height="250" CornerRadius="8"
                                                                        ClipToBounds="True">
                                                                        <Grid>
                                                                                <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                                                                                <Border VerticalAlignment="Bottom" Background="#AA000000" Padding="8">
                                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                                                   TextWrapping="Wrap"/>
                                                                                </Border>
                                                                        </Grid>
                                                                </Border>
                                                        </Button>
                                                </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Grid.Column="1" Spacing="16">
                                        <StackPanel x:Name="PanneauInfos" x:DataType="local:Game" Spacing="6" IsVisible="False">
                                                <Image Source="{Binding Cover}" Height="260" Stretch="Uniform"/>
                                                <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Date, StringFormat='Sortie : {0}'}"/>
                                                <TextBlock Text="{Binding Genre, StringFormat='Genre : {0}'}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Rating, StringFormat='Note : {0}'}"/>
                                                <TextBlock Text="{Binding Synopsis}" TextWrapping="Wrap"/>
                                                <CheckBox Content="Disponible"
                                                          IsChecked="{Binding Disponible, Mode=TwoWay}"
                                                          Click="ClikCheck"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Button Content="Modifier" Click="ModiferAfficher"/>
                                                        <Button Content="Supprimer" Click="Supprimer"/>
                                                </StackPanel>
                                        </StackPanel>
                                        <StackPanel x:Name="ModifierInfos" Spacing="5" IsVisible="False">
                                                <TextBox x:Name="GameName" PlaceholderText="Name?" TextWrapping="Wrap"/>
                                                <TextBox x:Name="GameDate" PlaceholderText="Date de sortie?" TextWrapping="Wrap"/>
                                                <TextBox x:Name="GameGenre" PlaceholderText="Genre?" TextWrapping="Wrap"/>
                                                <TextBox x:Name="GameSynopsis" PlaceholderText="Synopsis?" TextWrapping="Wrap"/>
                                                <TextBox x:Name="GameRating" PlaceholderText="Rating?" TextWrapping="Wrap"/>
                                                <TextBox x:Name="GameUrl" PlaceholderText="Url Image?" TextWrapping="Wrap"/>
                                                <Button Content="Enregistrer les modifications" Click="Modifier"/>
                                        </StackPanel>
                                        <StackPanel x:Name="Ajouterinfos" Spacing="5">
                                                <TextBlock Text="Ajouter un jeu" FontWeight="Bold"/>
                                                <TextBox x:Name="NomJeu" PlaceholderText="Name?" TextWrapping="Wrap"/>
                                                <TextBox x:Name="DateJeu" PlaceholderText="Date de sortie?" TextWrapping="Wrap"/>
                                                <TextBox x:Name="GenreJeu" PlaceholderText="Genre?" TextWrapping="Wrap"/>
                                                <TextBox x:Name="SynopsisJeu" PlaceholderText="Synopsis?" TextWrapping="Wrap"/>
                                                <TextBox x:Name="JeuScore" PlaceholderText="Rating?" TextWrapping="Wrap"/>
                                                <TextBox x:Name="UrlJeu" PlaceholderText="Url Image?" TextWrapping="Wrap"/>
                                                <Button Content="Ajouter" Click="Ajouter"/>
                                        </StackPanel>
                                </StackPanel>
                        </Grid>
                </StackPanel>
        </ScrollViewer>
</Window>