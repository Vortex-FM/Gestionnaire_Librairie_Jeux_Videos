<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Gestionnaire_de_librairie_Jeux_Videos"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Gestionnaire_de_librairie_Jeux_Videos.MainWindow"
        x:DataType="local:MainWindow"
        Title="Gestionnaire_de_librairie_Jeux_Videos">

    <ScrollViewer>
        <StackPanel Orientation="Horizontal">

            <ListBox x:Name="GameList"
                     ItemsSource="{Binding Games}"
                     Width="300"
                     MinHeight="300"
                     Background="#00000000"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:Game">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Button Grid.Column="0"
                                    Content="{Binding Name}"
                                    Click="AfficherInfo" />
                            <TextBlock Grid.Column="1"
                                       Text = " Disponible :"/>
                            <CheckBox Grid.Column="2"
                                      IsChecked="{Binding Disponible, Mode=TwoWay}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>



            <ListBox x:Name="GameInfo"
                     ItemsSource="{Binding GameInfos}"
                     Width="300"
                     MinHeight="300"
                     Background="#E014E0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:Game">
                        <Grid RowDefinitions="Auto, *, Auto">
                            <TextBlock Grid.Row="0"
                                       Text="{Binding Name}"/>
                            <TextBlock Grid.Row="1"
                                       Text = "{Binding Date}"/>
                            <TextBox Grid.Row="2"
                                     Text="{Binding Genre}"/>
                            <TextBox Grid.Row="3"
                                     Text="{Binding Synopsis}" TextWrapping="Wrap"/>
                            <TextBox Grid.Row="4"
                                     Text="{Binding Rating}"/>
                            <TextBox Grid.Row="5"
                                     Text="{Binding Disponible}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Top">
                <TextBox x:Name="SearchBox"
                         Width="200"
                         PlaceholderText="Rechercher un jeu..." />

                <Button Content="Rechercher"
                        Click="Rechercher" />
                <Button Content="Ajouter"
                        Click="Ajouter" />

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>

